<Window x:Class="ISIP223_Bulatov_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP223_Bulatov_WPF"
        mc:Ignorable="d"
        Title="КИПФИН Рогалик" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header / Stats -->
            <RowDefinition Height="*"/>
            <!-- Battle Arena -->
            <RowDefinition Height="Auto"/>
            <!-- Controls / Inventory -->
            <RowDefinition Height="Auto"/>
            <!-- Log -->
        </Grid.RowDefinitions>

        <!-- 1. ПАНЕЛЬ СТАТИСТИКИ ИГРОКА -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <!-- Минималистичный аватар (цветной квадрат/круг) -->
                <Border Width="40" Height="40" Background="#4CAF50" CornerRadius="4" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Игрок" FontWeight="Bold" FontSize="16"/>
                    <!-- ProgressBar для HP -->
                    <ProgressBar Width="200" Height="10" Minimum="0" Maximum="100" 
                                 Value="{Binding Player.HP, Mode=OneWay}"
                                 Background="#444" Foreground="#E91E63"/>
                    <TextBlock Text="{Binding Player.HP, StringFormat='HP: {0}/{1}', Mode=OneWay}" 
                               FontSize="10" Foreground="#AAA"/>
                </StackPanel>
                <!-- Статусы (например, заморозка) -->
                <Image x:Name="imgFrozen" Width="24" Height="24" Visibility="Collapsed" 
                       Source="/Resources/Icons/freeze.png" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. АРЕНА (Центральная часть) -->
        <Grid Grid.Row="1" Background="#252526" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Зона Игрока -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Placeholder для спрайта игрока (минимальная графика) -->
                <Border Width="80" Height="80" Background="#388E3C" CornerRadius="8" 
                        BorderBrush="#66BB6A" BorderThickness="2"/>
                <TextBlock Text="Герой" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- VS Индикатор -->
            <TextBlock Grid.Column="1" Text="VS" FontSize="24" FontWeight="Bold" 
                       Foreground="#FFD54F" VerticalAlignment="Center"/>

            <!-- Зона Врага -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Placeholder для спрайта врага (цвет зависит от типа) -->
                <Border x:Name="EnemyVisual" Width="80" Height="80" CornerRadius="8" 
                        BorderThickness="2" Background="#C62828" BorderBrush="#EF5350"/>
                <TextBlock Text="{Binding CurrentEnemy.Name}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <ProgressBar Width="100" Height="6" Minimum="0" Maximum="{Binding CurrentEnemy.MaxHP}"
                             Value="{Binding CurrentEnemy.HP}" Foreground="#F44336" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 3. ПАНЕЛЬ УПРАВЛЕНИЯ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <!-- Кнопки действий -->
            <Button Content="⚔️ Атака" Width="100" Margin="5" Click="BtnAttack_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="🛡️ Защита" Width="100" Margin="5" Click="BtnDefend_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="💧 Лечение" Width="100" Margin="5" Click="BtnHeal_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>

            <Separator Width="20" Background="Transparent"/>

            <!-- Быстрый слот предмета -->
            <Border Background="#333" Padding="10" CornerRadius="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Width="20" Height="20" Background="#FFA000" CornerRadius="2" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Player.Weapon.Name}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 4. ЛОГ СОБЫТИЙ -->
        <Border Grid.Row="3" Background="#111" CornerRadius="4" Padding="5" Height="100">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LogList" FontSize="11" Foreground="#CCC">
                    <!-- Сюда добавляются сообщения о бое -->
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
