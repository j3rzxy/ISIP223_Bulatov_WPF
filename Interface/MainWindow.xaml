<Window x:Class="ISIP223_Bulatov_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP223_Bulatov_WPF"
        mc:Ignorable="d"
        Title="КИПФИН Рогалик" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White">

    <Window.Resources>
        <local:EnemyTypeToBrushConverter x:Key="EnemyTypeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Stats -->
            <RowDefinition Height="*"/>
            <!-- Arena -->
            <RowDefinition Height="Auto"/>
            <!-- Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Log -->
        </Grid.RowDefinitions>

        <!-- 1. ПАНЕЛЬ СТАТИСТИКИ ИГРОКА -->
        <!-- Используем Border для CornerRadius и Padding -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <!-- Аватар игрока -->
                <Border Width="40" Height="40" Background="#4CAF50" Margin="0,0,10,0" 
                        ToolTip="Герой">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Для совместимости с .NET Framework -->
                            <Setter Property="CornerRadius" Value="4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                    <Setter Property="CornerRadius" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding PlayerName}" FontWeight="Bold" FontSize="16"/>
                    <!-- HP Bar -->
                    <ProgressBar Width="200" Height="10" Minimum="0" Maximum="{Binding PlayerMaxHP}" 
                                 Value="{Binding PlayerHP}"
                                 Background="#444" Foreground="#E91E63" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding PlayerHPText}" FontSize="10" Foreground="#AAA"/>
                </StackPanel>

                <!-- Статус заморозки -->
                <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="❄️ Заморожен!" Foreground="#81D4FA" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. АРЕНА -->
        <Border Grid.Row="1" Background="#252526" Margin="0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Игрок -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="80" Height="80" Background="#388E3C" 
                            BorderBrush="#66BB6A" BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="🤴" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Герой" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#AAA"/>
                    <TextBlock Text="{Binding PlayerStatsText}" FontSize="10" Foreground="#666" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- VS -->
                <TextBlock Grid.Column="1" Text="VS" FontSize="24" FontWeight="Bold" 
                           Foreground="#FFD54F" VerticalAlignment="Center"/>

                <!-- Враг -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Динамический цвет врага -->
                    <Border Width="80" Height="80" BorderThickness="2" 
                            Background="#C62828" 
                            BorderBrush="{Binding CurrentEnemyType, Converter={StaticResource EnemyTypeConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="👹" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentEnemyName}" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold"/>
                    <ProgressBar Width="100" Height="6" Minimum="0" Maximum="{Binding CurrentEnemyMaxHP, Mode=OneWay}"
                                 Value="{Binding CurrentEnemyHP, Mode=OneWay}" Foreground="#F44336" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding CurrentEnemyHPText, Mode=OneWay}" FontSize="9" Foreground="#AAA" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. ПАНЕЛЬ УПРАВЛЕНИЯ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <!-- Только две кнопки: Атака и Защита -->
            <Button Content="⚔️ Атака" Width="100" Margin="5" Click="BtnAttack_Click"
            IsEnabled="{Binding IsGameActive}"/>
            <Button Content="🛡️ Защита" Width="100" Margin="5" Click="BtnDefend_Click"
            IsEnabled="{Binding IsGameActive}"/>

            <Separator Width="20" Background="Transparent"/>

            <!-- Инвентарь / Слоты -->
            <Border Background="#333" Padding="10" CornerRadius="4" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                <Setter Property="CornerRadius" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Оружие:" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="{Binding PlayerWeaponName}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Броня:" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="{Binding PlayerArmorName}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 4. ЛОГ СОБЫТИЙ -->
        <Border Grid.Row="3" Background="#111" Padding="5" Height="200">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                            <Setter Property="CornerRadius" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LogList" FontSize="11" Foreground="#CCC">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Экран победы/поражения (Overlay) -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#88000000" 
              Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#2D2D30" 
                    Padding="30">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                <Setter Property="CornerRadius" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding GameOverMessage}" FontSize="24" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#FF5252"/>
                    <Button Content="🔄 Новая игра" Width="150" Click="BtnRestart_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>