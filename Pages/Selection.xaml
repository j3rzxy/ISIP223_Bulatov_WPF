<Page x:Class="ISIP223_Bulatov_WPF.Pages.Selection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP223_Bulatov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Выбор комплектующего">

    <Grid Background="#F5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="LightGray"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <Button Content="← Назад" Click="BtnBack_Click" 
                        Padding="15,5" Background="Transparent" BorderBrush="#34495E" Foreground="#34495E"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#7F8C8D"/>
                    <TextBox x:Name="TbSearch" Width="300" Padding="5" TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Производитель:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#7F8C8D"/>
                    <ComboBox x:Name="CbManufacturer" Width="150" SelectionChanged="FilterChanged" DisplayMemberPath="name"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <ListView Grid.Row="1"  ScrollViewer.VerticalScrollBarVisibility="Auto" x:Name="LvParts" Background="Transparent" BorderThickness="0" 
                    HorizontalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="LvParts_SelectionChanged">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="260" Height="300" Background="White" CornerRadius="10" Margin="10" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#E0E0E0"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Source="{Binding image}" Stretch="Uniform" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Text="{Binding name}" FontWeight="Bold" FontSize="16" 
                        TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="2" Text="{Binding manufacturer_.name}" Foreground="#7F8C8D" Margin="0,5"/>

                                <StackPanel Grid.Row="3">
                                    <TextBlock Text="{Binding price, StringFormat={}{0:N2} ₽}" 
                            FontSize="20" FontWeight="Black" Foreground="#27AE60" Margin="0,0,0,10"/>
                                    <Button Content="Добавить в сборку" Background="#2980B9" Foreground="White" 
                        Padding="10" Click="BtnSelect_Click" Tag="{Binding id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="DetailsPanel" Grid.Row="1" Grid.Column="1" Background="White" Margin="10,0,0,0" Padding="20" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#CCCCCC"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Margin="0,-5,0,5" Content="✕ Закрыть" HorizontalAlignment="Right" Click="CloseDetails_Click" Padding="15,5" Background="Transparent" BorderBrush="#34495E" Foreground="#34495E"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="5">


                            <Image x:Name="ImgDetail" Height="200" Stretch="Uniform" Margin="0,10"/>

                            <TextBlock x:Name="TxtDetailName" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10"/>
                            <TextBlock x:Name="TxtDetailPrice" FontSize="24" FontWeight="Black" Foreground="#27AE60" Margin="0,0,0,20"/>

                            <TextBlock Text="Характеристики:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                            <ItemsControl x:Name="IcSpecs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <TextBlock Text="{Binding Key}" Foreground="#7F8C8D" />
                                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="Medium" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Выбрать эту деталь" Margin="0,30,0,0" Padding="12" Background="#27AE60" Foreground="White" Click="BtnChooseSelect_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
