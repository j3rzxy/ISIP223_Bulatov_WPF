<Page x:Class="ISIP223_Bulatov_WPF.Pages.Choice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP223_Bulatov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Конфигуратор сборки">

    <Grid>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                <StackPanel x:Name="PartsStackPanel" Margin="5">
                    <Grid>
                        <TextBlock Text="Выбор комплектующих" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>
                        <Button x:Name="ClearButton" FontWeight="Bold" Foreground="White" Background="#FFFF4545" Content="X" Padding="10,5" Margin="0,0,15,0" VerticalAlignment="Center" HorizontalAlignment="Right" Click="ClearButton_Click"/>
                    </Grid>
                    <ItemsControl x:Name="PartsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D0D0D0" Opacity="1"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" Width="120" VerticalAlignment="Center" Foreground="#7F8C8D"/>
                                            <Image Source="{Binding ImagePath}" Width="60" Height="60" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <TextBlock Tag="{Binding SelectedPartId}" TextDecorations="Underline" Cursor="Hand" MouseDown="PartName_MouseDown" Grid.Column="1" Text="{Binding SelectedPartName}" FontSize="16" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Column="2" Text="{Binding PriceString}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0" Foreground="#27AE60"/>

                                        <Button Grid.Column="3" Content="Выбрать" 
                                            Background="#2980B9"
                                            Foreground="White"
                                            Padding="15,5" Height="30"
                                            Click="SelectPart_Click" 
                                            Tag="{Binding CategoryId}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#CCCCCC"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Итоги сборки" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Separator Margin="0,0,0,15"/>

                    <TextBlock Text="Название сборки:" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <TextBox x:Name="TbAssemblyName" Padding="8" Margin="0,0,0,15"/>

                    <TextBlock Text="Автор:" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <TextBox x:Name="TbAuthorName" Padding="8" Margin="0,0,0,20"/>

                    <TextBlock Text="Статус совместимости:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtCompatibility" Text="Все в порядке" Foreground="#27AE60" Margin="0,0,0,20" TextWrapping="Wrap"/>

                    <Separator Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Общая стоимость:" FontSize="16" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="TxtTotalPrice" Text="0 ₽" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#2C3E50"/>
                    </Grid>

                    <Button Content="СОХРАНИТЬ СБОРКУ" 
                        Background="#27AE60" Foreground="White" 
                        FontWeight="Bold" Padding="10,15"
                        Click="SaveAssembly_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ModalOverlay" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="#80000000" MouseDown="CloseModal_Click" />

            <Border Background="White" 
                CornerRadius="20" 
                Width="500" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,20" Grid.Row="0">
                        <TextBlock Text="Детали компонента" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <Button Padding="5,0" Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" 
                FontSize="18" Cursor="Hand" Click="CloseModal_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                        <StackPanel>
                            <Image x:Name="ModalImg" Height="200" Stretch="Uniform" Margin="0,0,0,20"/>

                            <TextBlock x:Name="ModalTitle" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="ModalPrice" FontSize="26" FontWeight="Black" Foreground="#27AE60" 
           TextAlignment="Center" Margin="0,10,0,20"/>

                            <Separator Background="#F0F0F0" Margin="0,0,0,20"/>

                            <ItemsControl x:Name="ModalSpecs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <TextBlock Text="{Binding Key}" Foreground="#7F8C8D" FontSize="14"/>
                                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
